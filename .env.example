# Private local artifacts. Use absolute paths; never commit the resolved values.
MT_CHECKPOINT_PATH=/absolute/path/to/checkpoint/e1_fairseq_vi_zh_v1/checkpoint_best.pt
MT_DATA_BIN_PATH=/absolute/path/to/work/e1_fairseq_vi_zh_v1/data-bin

# E1 uses CPU on Apple Silicon. Set cuda only in the Linux/NVIDIA environment.
MT_DEVICE=cpu
MT_PORT=8000
