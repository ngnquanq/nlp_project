# Private local artifacts. Use absolute paths; never commit the resolved values.
MT_CHECKPOINT_PATH=/absolute/path/to/checkpoint/e1_fairseq_vi_zh_v1/checkpoint_best.pt
MT_DATA_BIN_PATH=/absolute/path/to/work/e1_fairseq_vi_zh_v1/data-bin

# E1 uses CPU on Apple Silicon. Set cuda only in the Linux/NVIDIA environment.
MT_DEVICE=cpu
MT_PORT=8000

# --------------------------------------------------------------------- E2
# E2 (Qwen3-8B QLoRA) runs in a separate process because fairseq 0.12.2 needs
# numpy<2 while the Qwen stack needs numpy 2.x. Leave MT_E2_URL unset to keep
# the E1-only behaviour; setting it makes the gateway forward E2 requests.

# Read by the gateway (:8000)
MT_E2_URL=http://127.0.0.1:8001
MT_E2_TIMEOUT_SECONDS=900
MT_E2_HEALTH_TTL_SECONDS=5

# Read by the sidecar (:8001)
MT_E2_PORT=8001
MT_E2_CONFIG_PATH=configs/e2_qwen3_qlora.yaml
# Both default to the paths in the E2 config; override only to relocate them.
# MT_E2_ADAPTER_PATH=/absolute/path/to/checkpoint/e2_qwen3_8b_qlora_vi_zh_v1/adapter
# MT_E2_MANIFEST_PATH=/absolute/path/to/work/e2_qwen3_8b_qlora_vi_zh_v1/run_manifest.json
MT_E2_MAX_PROMPT_TOKENS=512
MT_E2_DEVICE=cuda
